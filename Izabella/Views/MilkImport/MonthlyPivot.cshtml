@using Izabella.Models.ViewModels
@model MonthlyPivotViewModel

<div class="card shadow mb-4 no-print">
    <div class="card-body">
        <form method="get" id="reportForm" class="row g-3 align-items-end">
            <input type="hidden" name="type" id="currentType" value="@Model.ReportType" />

            <div class="col-md-2">
                <label class="form-label">Év</label>
                <input type="number" name="year" class="form-control" value="@Model.SelectedMonth.Year" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Hónap</label>
                <select name="month" class="form-select">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(Model.SelectedMonth.Month == i)">
                            @System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(i)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label d-block">Adattípus</label>
                <div class="btn-group w-100" role="group">
                    <button type="button" onclick="setType('Yield')" class="btn btn-outline-primary @(Model.ReportType == MilkReportType.Yield ? "active" : "")">Tej (kg)</button>
                    <button type="button" onclick="setType('Fat')" class="btn btn-outline-primary @(Model.ReportType == MilkReportType.Fat ? "active" : "")">Tejzsír %</button>
                    <button type="button" onclick="setType('Protein')" class="btn btn-outline-primary @(Model.ReportType == MilkReportType.Protein ? "active" : "")">Fehérje %</button>
                </div>
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Szűrés</button>
                <a asp-action="ExportMonthlyPivotToExcel"
                   asp-route-year="@Model.SelectedMonth.Year"
                   asp-route-month="@Model.SelectedMonth.Month"
                   asp-route-type="@Model.ReportType"
                   class="btn btn-success">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </a>
            </div>
        </form>

        <script>
            function setType(val) {
                    document.getElementById('currentType').value = val;
                    document.getElementById('reportForm').submit();
            }
        </script>
    </div>
</div>
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Kereszttáblás jelentés: @Model.SelectedMonth.ToString("yyyy. MMMM")</h6>
        <button onclick="window.print()" class="btn btn-sm btn-dark no-print">Nyomtatás</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 700px;">
            <table class="table table-bordered table-sm pivot-table m-0">
                <thead class="table-dark sticky-top">
                    <tr>
                        <th rowspan="2" class="align-middle bg-dark">Fülszám</th>
                        @foreach (var day in Model.DaysInMonth)
                        {
                            @if (Model.ReportType == MilkReportType.Yield)
                            {
                                <th colspan="3" class="text-center border-start">@day.</th>
                            }
                            else
                            {
                                <th class="text-center border-start" style="min-width: 60px;">@day.</th>
                            }
                        }
                        <th rowspan="2" class="align-middle text-center bg-primary">Havi Átlag</th>
                    </tr>
                    @if (Model.ReportType == MilkReportType.Yield)
                    {
                        <tr class="fejes-sor">
                            @foreach (var day in Model.DaysInMonth)
                            {
                                <th class="border-start">1.</th>
                                <th>2.</th>
                                <th>3.</th>
                            }
                        </tr>
                    }
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="fw-bold bg-light">@row.EarTag</td>
                            @foreach (var day in Model.DaysInMonth)
                            {
                                var data = row.DailyData[day];
                                if (Model.ReportType == MilkReportType.Yield)
                                {
                                    <td class="border-start">@(data.HasData ? data.Y1.ToString("N1") : "")</td>
                                    <td>@(data.HasData ? data.Y2.ToString("N1") : "")</td>
                                    <td>@(data.HasData ? data.Y3.ToString("N1") : "")</td>
                                }
                                else
                                {
                                    <td colspan="3" class="text-center border-start @(data.HasData ? "" : "bg-light")">
                                        @(data.HasData ? data.Y1.ToString("N2") : "-")
                                    </td>
                                }
                            }
                            <td class="text-center fw-bold bg-primary text-white">
                                @row.RowAverage.ToString(Model.ReportType == MilkReportType.Yield ? "N1" : "N2")
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-secondary sticky-bottom">
                    @if (Model.ReportType == MilkReportType.Yield)
                    {
                        <tr class="fw-bold">
                            <td>Napi összes (kg)</td>
                            @foreach (var day in Model.DaysInMonth)
                            {
                                <td class="border-start">@Model.DailyTotals[day].SumY1.ToString("N0")</td>
                                <td>@Model.DailyTotals[day].SumY2.ToString("N0")</td>
                                <td>@Model.DailyTotals[day].SumY3.ToString("N0")</td>
                            }
                            <td></td>
                        </tr>
                        <tr class="fw-bold table-info">
                            <td>Napi Teljes</td>
                            @foreach (var day in Model.DaysInMonth)
                            {
                                <td colspan="3" class="text-center border-start">@Model.DailyTotals[day].DayTotal.ToString("N0") kg</td>
                            }
                            <td class="text-center">@(Model.Rows.Any() ? Model.Rows.Average(r => r.RowAverage).ToString("N1") : "0,0")</td>
                        </tr>
                    }
                    else
                    {
                        <tr class="fw-bold table-info">
                            <td>@(Model.ReportType == MilkReportType.Yield ? "Napi Teljes" : "Napi Átlag %")</td>
                            @foreach (var day in Model.DaysInMonth)
                            {
                                <td colspan="3" class="text-center border-start">
                                    @if (Model.ReportType == MilkReportType.Yield)
                                    {
                                        <span>@Model.DailyTotals[day].DayTotal.ToString("N0") kg</span>
                                    }
                                    else
                                    {
                                        <span>@(Model.DailyTotals[day].DayTotal > 0 ? Model.DailyTotals[day].DayTotal.ToString("N2") + " %" : "-")</span>
                                    }
                                </td>
                            }
                            <td class="text-center">@(Model.Rows.Any() ? Model.Rows.Average(r => r.RowAverage).ToString(Model.ReportType == MilkReportType.Yield ? "N1" : "N2") : "0,0")</td>
                        </tr>
                    }
                    <tr class="table-light">
                        <td>Mért állatok száma</td>
                        @foreach (var day in Model.DaysInMonth)
                        {
                            var cowsToday = Model.Rows.Count(r => r.DailyData[day].HasData);
                            <td colspan="3" class="text-center border-start">@cowsToday db</td>
                        }
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
<div class="card shadow mb-4 no-print">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Havi termelési görbe</h6>
    </div>
    <div class="card-body">
        <canvas id="productionChart" style="width:100%; height:300px;"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById('productionChart').getContext('2d');

        // Adatok kinyerése a modellből
        const labels = @Html.Raw(Json.Serialize(Model.DaysInMonth.Select(d => d + ".")));
        const dataValues = @Html.Raw(Json.Serialize(Model.DaysInMonth.Select(d => Model.DailyTotals[d].DayTotal)));

        new Chart(ctx, {
        type: 'line',
        data: {
        labels: labels,
        datasets: [{
        label: @Json.Serialize(Model.ReportType == MilkReportType.Yield ? "Napi összes tej (kg)" : Model.ReportType == MilkReportType.Fat ? "Tejzsír %" : "Tejfehérje %"),
        data: dataValues,
        borderColor: '#4e73df',
        backgroundColor: 'rgba(78, 115, 223, 0.1)',
        pointBackgroundColor: '#4e73df',
        fill: true,
        tension: 0.3
        }]
        },
        options: {
        maintainAspectRatio: false,
        scales: {
        y: {
        beginAtZero: true,
        title: { display: true, text: '@(Model.ReportType == MilkReportType.Yield ? "kg" : "%")' }
        }
        },
        plugins: {
        legend: { display: true, position: 'top' }
        }
        }
        });
        });
    </script>
}
<style>
    .pivot-table {
        font-size: 0.75rem;
        white-space: nowrap;
    }

        .pivot-table td:first-child,
        .pivot-table th:first-child {
            position: sticky;
            left: 0;
            z-index: 10;
            background-color: #f8f9fa; /* Világos szürke háttér, hogy ne látsszanak alatta a számok */
            border-right: 2px solid #dee2e6;
        }

        .pivot-table thead th:first-child {
            z-index: 20; /* A sarok legyen minden felett */
            background-color: #212529; /* Sötét, mint a többi fejléc */
        }

        .pivot-table th, .pivot-table td {
            padding: 0.2rem 0.4rem;
            text-align: right;
        }

    .fejes-sor th {
        font-size: 0.65rem;
        font-weight: normal;
    }

    @@media print {
        @@page {
            size: A3 landscape;
            margin: 5mm;
        }

        .no-print {
            display: none;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .sticky-top, .sticky-bottom {
            position: static !important;
        }
    }
</style>
