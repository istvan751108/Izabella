@{
    ViewData["Title"] = "Állatgyógyászat";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary"><i class="bi bi-heart-pulse-fill"></i> Állatgyógyászati Kezelések</h1>
        <p class="text-muted fs-5">Válassza ki a kezelés kategóriáját az új esemény rögzítéséhez és a gyógyszer felhasználásához.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 justify-content-center">
        <div class="col-md-5 col-lg-3">
            <div class="card h-100 shadow-sm border-0 text-center hover-card">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div class="my-3">
                        <i class="bi bi-shield-plus text-danger display-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Tőgykezelés</h3>
                    <p class="card-text text-muted small">Mastitis, tőgygyulladások kezelése és helyi tubusok beadása.</p>
                    <a asp-action="Create" asp-route-category="Tőgy" class="btn btn-danger w-100 fw-bold mt-3 py-2 shadow-sm">
                        Kezelés indítása <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5 col-lg-3">
            <div class="card h-100 shadow-sm border-0 text-center hover-card">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div class="my-3">
                        <i class="bi bi-bandaid text-warning display-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Lábkezelés</h3>
                    <p class="card-text text-muted small">Sántaság, csülökproblémák, kötözések és lábápolási szerek.</p>
                    <a asp-controller="Treatments" asp-action="CreateLáb" class="btn btn-warning text-dark w-100 fw-bold mt-3 py-2 shadow-sm">
                        <i class="bi bi-activity me-2"></i> Kezelés indítása
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5 col-lg-3">
            <div class="card h-100 shadow-sm border-0 text-center hover-card">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div class="my-3">
                        <i class="bi bi-gender-ambiguous text-info display-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Szaporodás</h3>
                    <p class="card-text text-muted small">Ivarzás-szinkronizálás, hormonkezelések, méhkezelések.</p>
                     <a asp-controller="Treatments" asp-action="CreateSzaporodás" class="btn btn-info text-white w-100 fw-bold mt-3 py-2 shadow-sm">
                        <i class="bi bi-calendar-check me-2"></i> Kezelés indítása
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5 col-lg-3">
            <div class="card h-100 shadow-sm border-0 text-center hover-card">
                <div class="card-body d-flex flex-column justify-content-between p-4">
                    <div class="my-3">
                        <i class="bi bi-activity text-success display-1"></i>
                    </div>
                    <h3 class="card-title fw-bold">Egyéb kezelés</h3>
                    <p class="card-text text-muted small">Vitaminok, általános antibiotikumok, infúziók, lázas állapotok.</p>
                    <a asp-controller="Treatments" asp-action="CreateEgyéb" class="btn btn-success w-100 fw-bold mt-3 py-2 shadow-sm">
                        <i class="bi bi-heart-pulse me-2"></i> Kezelés indítása
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
        }
</style>