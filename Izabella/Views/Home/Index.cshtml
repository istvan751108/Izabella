@{
    ViewData["Title"] = "Főoldal";
}

<style>
    .hero-section {
        background-color: white;
        padding: 40px;
        border-radius: 15px;
        margin-bottom: 40px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
    }

    .hero-logo-img {
        max-height: 150px;
        object-fit: contain;
    }

    .hero-text-block {
        text-align: left;
        color: #2c3e50;
    }

    .nav-card {
        transition: all 0.3s ease;
        border: none;
        border-top: 4px solid transparent;
        height: 100%;
    }

        .nav-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    /* Színkódok a menü alapján */
    .card-cattle {
        border-top-color: #2c3e50;
    }

    .card-ops {
        border-top-color: #6c757d;
    }

    .card-repro {
        border-top-color: #dc3545;
    }

    .card-manure {
        border-top-color: #198754;
    }

    .card-support {
        border-top-color: #0dcaf0;
    }

    .card-admin {
        border-top-color: #ffc107;
    }

    .card-milk {
        border-top-color: #3498db;
    }

    .card-milking {
        border-top-color: #9b59b6;
    }

    /* ÚJ: Gyógykezelések egyedi színkódja (orvosi menta/türkiz) */
    .card-treatment {
        border-top-color: #1abc9c;
    }

    .nav-icon {
        font-size: 2.5rem;
        margin-bottom: 15px;
        display: block;
    }

    .card-title {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .text-small {
        font-size: 0.85rem;
        line-height: 1.4;
    }
</style>

<div class="container mt-4">
    <div class="hero-section shadow-sm">
        <img src="~/images/logo/izabella_logo_clean.png" alt="Izabella Logo" class="hero-logo-img" />
        <div class="hero-text-block">
            <h1 class="display-4 fw-bold mb-0">Izabella DB</h1>
            <p class="lead fs-5">Telepirányítási és Állategészségügyi Rendszer</p>
            <div class="mt-2">
                <span class="badge bg-dark p-2 px-3">v2.1 Build 2026.05</span>
                <span class="badge bg-outline-secondary text-dark border p-2 px-3 ms-2">@DateTime.Now.ToString("yyyy. MMMM dd.")</span>
            </div>
        </div>
    </div>

    <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 justify-content-center">
        <div class="col">
            <a asp-controller="Cattles" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card shadow-sm nav-card card-cattle text-center">
                    <div class="card-body">
                        <i class="bi bi-list-check nav-icon text-dark"></i>
                        <h5 class="card-title">Állomány</h5>
                        <p class="text-small text-muted">Aktív lista, ellés, ENAR és mozgás.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="Treatments" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card shadow-sm nav-card card-treatment text-center">
                    <div class="card-body">
                        <i class="bi bi-heart-pulse nav-icon" style="color: #1abc9c;"></i>
                        <h5 class="card-title">Kezelések</h5>
                        <p class="text-small text-muted">Tőgy, láb, ÉVI zárlatok és gyógyszerek.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="MilkImport" asp-action="MonthlyPivot" class="text-decoration-none text-dark">
                <div class="card shadow-sm nav-card card-milk text-center">
                    <div class="card-body">
                        <i class="fa-solid fa-cow nav-icon text-info"></i>
                        <h5 class="card-title">Laktáció</h5>
                        <p class="text-small text-muted">Tejtermelés, Afimilk import és rangsor.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="MilkLabImport" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card shadow-sm nav-card card-milking text-center">
                    <div class="card-body">
                        <i class="bi bi-droplet-half nav-icon" style="color: #9b59b6;"></i>
                        <h5 class="card-title">Próbafejés</h5>
                        <p class="text-small text-muted">Labor adatok, befejezések és összefüggések.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="Weight" asp-action="QuickWeightEntry" class="text-decoration-none text-dark">
                <div class="card shadow-sm nav-card card-ops text-center">
                    <div class="card-body">
                        <i class="bi bi-geo-alt nav-icon text-secondary"></i>
                        <h5 class="card-title">Helyszíni</h5>
                        <p class="text-small text-muted">Súlymérés, leltár és vérvétel.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="Insemination" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card shadow-sm nav-card card-repro text-center">
                    <div class="card-body">
                        <i class="bi bi-calendar-check nav-icon text-danger"></i>
                        <h5 class="card-title">Szaporodás</h5>
                        <p class="text-small text-muted">Inszeminálás, VEX és sperma.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="Report" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card shadow-sm nav-card card-manure text-center">
                    <div class="card-body">
                        <i class="bi bi-moisture nav-icon text-success"></i>
                        <h5 class="card-title">Trágya</h5>
                        <p class="text-small text-muted">Rögzítés, riportok és grafikonok.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="CattleReports" asp-action="SlaughterSupportIndex" class="text-decoration-none text-dark">
                <div class="card shadow-sm nav-card card-support text-center">
                    <div class="card-body">
                        <i class="bi bi-file-earmark-pdf nav-icon text-primary"></i>
                        <h5 class="card-title">Támogatás</h5>
                        <p class="text-small text-muted">2334, 2335 PDF és beállítások.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-controller="Companies" asp-action="Index" class="text-decoration-none text-dark">
                <div class="card shadow-sm nav-card card-admin text-center">
                    <div class="card-body">
                        <i class="bi bi-gear-fill nav-icon text-warning"></i>
                        <h5 class="card-title">Admin</h5>
                        <p class="text-small text-muted">Cégek, tenyészetek és júzerek.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="text-center mt-5 mb-4 text-muted small">
        <hr class="w-25 mx-auto" />
        <p>© 2026 Izabella Farm Management Software | All Rights Reserved</p>
    </div>
</div>