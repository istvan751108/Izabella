@model Izabella.Models.Company

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-info-square text-info me-2"></i>Cég részadatai</h4>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Vissza a listához
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-info bg-opacity-10 py-3">
            <h5 class="card-title mb-0 text-info-emphasis">@Model.Name</h5>
        </div>
        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-sm-3 text-muted fw-bold">@Html.DisplayNameFor(model => model.Name)</div>
                <div class="col-sm-9 fs-5">@Html.DisplayFor(model => model.Name)</div>
            </div>
            <div class="row mb-4">
                <div class="col-sm-3 text-muted fw-bold">@Html.DisplayNameFor(model => model.ClientId)</div>
                <div class="col-sm-9">
                    <span class="badge bg-light text-dark border px-3 py-2">@Html.DisplayFor(model => model.ClientId)</span>
                </div>
            </div>
            <div class="row mb-0">
                <div class="col-sm-3 text-muted fw-bold">@Html.DisplayNameFor(model => model.Address)</div>
                <div class="col-sm-9"><i class="bi bi-geo-alt me-2"></i>@Html.DisplayFor(model => model.Address)</div>
            </div>
        </div>
        <div class="card-footer bg-light p-3 text-end">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                <i class="bi bi-pencil me-1"></i> Szerkesztés
            </a>
        </div>
    </div>
</div>