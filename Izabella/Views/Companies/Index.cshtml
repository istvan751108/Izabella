@model IEnumerable<Izabella.Models.Company>

@{
    ViewData["Title"] = "Cégadatok kezelése";
}

<div class="container-fluid px-4 py-3">
    <!-- Fejléc és Új gomb -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0"><i class="bi bi-buildings-fill text-secondary me-2"></i>Cégadatok Kezelése</h4>
            <small class="text-muted">A rendszerben rögzített saját cégek listája</small>
        </div>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Új Cég felvitele
        </a>
    </div>

    <!-- Táblázat kártyában -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3" style="width: 70%">
                                <i class="bi bi-info-circle me-1"></i> @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th class="text-end pe-4 py-3">Műveletek</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Szerkesztés">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Részletek">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Törlés">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="2" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Nincs még rögzített cég a rendszerben.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Egyedi stílusok a céglistához */
    .table-hover tbody tr:hover {
        background-color: rgba(0,0,0,.02);
        transition: background-color 0.2s ease;
    }

    .btn-group-sm .btn {
        padding: 0.4rem 0.6rem;
    }

    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    /* Ikonok finomítása */
    .bi {
        vertical-align: -0.125em;
    }
</style>
