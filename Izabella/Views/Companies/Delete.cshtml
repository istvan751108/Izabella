@model Izabella.Models.Company

<div class="container-fluid px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3 text-center">
                    <h5 class="card-title mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Biztosan törölni szeretné?</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="text-muted">Az alábbi cég adatai véglegesen törlésre kerülnek:</p>
                    <h3 class="my-3">@Model.Name</h3>
                    <div class="bg-light p-3 rounded mb-4">
                        <small class="text-muted d-block">Ügyfél-azonosító:</small>
                        <strong>@Model.ClientId</strong>
                    </div>

                    <form asp-action="Delete" class="d-flex justify-content-center gap-3">
                        <input type="hidden" asp-for="Id" />
                        <a asp-action="Index" class="btn btn-secondary px-4">Mégse</a>
                        <button type="submit" class="btn btn-danger px-4 shadow">
                            <i class="bi bi-trash me-1"></i> Törlés megerősítése
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>