@model IEnumerable<Izabella.Models.AbortionReportViewModel>

@{
    ViewData["Title"] = "Vetélési jelentés";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-exclamation-octagon text-danger"></i> Vetélési jelentés</h2>
        <a asp-action="ExpectedCalvings" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-calendar-date"></i> Vissza a várható ellésekhez
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light">
            <form method="get" asp-action="AbortionReport" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Év</label>
                    <input type="number" name="year" class="form-control" value="@ViewBag.CurrentYear" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Hónap</label>
                    <select name="month" class="form-select">
                        @for (int i = 1; i <= 12; i++)
                        {
                            if (i == ViewBag.CurrentMonth)
                            {
                                <option value="@i" selected>@i.ToString("D2")</option>
                            }
                            else
                            {
                                <option value="@i">@i.ToString("D2")</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100">
                        <i class="bi bi-filter"></i> Szűrés
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i>
            Ebben az időszakban (@ViewBag.CurrentYear. @ViewBag.CurrentMonth.) nem rögzítettek vetélést.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover border shadow-sm">
                <thead class="table-danger">
                    <tr>
                        <th>Fülszám</th>
                        <th>Esemény dátuma</th>
                        <th>Hanyadik vetélés?</th>
                        <th>Megjegyzés</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.EarTag</strong></td>
                            <td>@item.AbortionDate.ToString("yyyy.MM.dd.")</td>
                            <td>
                                @if (item.AbortionCount > 1)
                                {
                                    <span class="badge bg-danger rounded-pill">
                                        <i class="bi bi-arrow-repeat"></i> @item.AbortionCount. (Ismétlődő)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">@item.AbortionCount.</span>
                                }
                            </td>
                            <td class="text-muted small italic">@item.Comment</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="row mt-3">
        <div class="col-md-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Összes vetélés (Hónap)</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count() db</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-graph-down-arrow fs-2 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-danger {
        border-left: 0.25rem solid #dc3545 !important;
    }

    .text-xs {
        font-size: .7rem;
    }
</style>