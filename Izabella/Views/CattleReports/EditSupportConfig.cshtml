@model Izabella.Models.SupportFormConfig

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-gear-fill text-secondary me-2"></i>Nyomtatvány alapbeállításai</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="SlaughterSupportIndex">Támogatások</a></li>
                <li class="breadcrumb-item active">Konfiguráció</li>
            </ol>
        </nav>
    </div>

    <form asp-action="EditSupportConfig" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">
            <!-- Bal oldali kártya: Engedélyes adatai -->
            <div class="col-xl-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light py-3">
                        <h5 class="card-title mb-0"><i class="bi bi-building me-2 text-primary"></i>Engedélyes (Vágóhíd/Szervezet) adatai</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Engedélyes neve (3. mező)</label>
                            <input asp-for="LicenseeName" class="form-control border-primary-subtle" placeholder="Hivatalos név" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Engedélyes Ügyfél-azonosítója</label>
                            <input asp-for="LicenseeClientId" class="form-control border-primary-subtle" placeholder="Pl. 1001234567" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-bold">Aláírás helyszíne</label>
                            <input asp-for="FilingPlace" class="form-control border-primary-subtle" placeholder="Település neve" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Jobb oldali kártya: 2334-es gyógyszerek -->
            <div class="col-xl-6">
                <div class="card shadow-sm h-100 border-info-subtle">
                    <div class="card-header bg-info bg-opacity-10 py-3">
                        <h5 class="card-title mb-0 text-info-emphasis"><i class="bi bi-capsule me-2"></i>Alapértelmezett Gyógyszerek (2334)</h5>
                    </div>
                    <div class="card-body">
                        @for (int i = 1; i <= 3; i++)
                        {
                            var nameProp = $"Medication{i}Name";
                            var agentProp = $"Medication{i}Agent";
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Gyógyszer @i</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-prescription2"></i></span>
                                    <input name="@nameProp" value="@Model.GetType().GetProperty(nameProp).GetValue(Model)" class="form-control" placeholder="Gyógyszer neve" />
                                    <input name="@agentProp" value="@Model.GetType().GetProperty(agentProp).GetValue(Model)" class="form-control w-50" placeholder="Hatóanyag" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Alsó széles kártya: Vemhes üsző gyógyszerek -->
            <div class="col-12">
                <div class="card shadow-sm border-success-subtle">
                    <div class="card-header bg-success bg-opacity-10 py-3">
                        <h5 class="card-title mb-0 text-success-emphasis">
                            <i class="bi bi-gender-female me-2"></i>Vemhes üsző támogatás gyógyszerei (2335)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @for (int i = 1; i <= 3; i++)
                            {
                                var nameProp = $"HeiferMed{i}Name";
                                var agentProp = $"HeiferMed{i}Agent";

                                <div class="col-lg-4 mb-3 mb-lg-0">
                                    <label class="form-label small fw-bold text-muted">Vemhes Gyógyszer @i</label>
                                    <div class="input-group">
                                        <input name="@nameProp" value="@Model.GetType().GetProperty(nameProp).GetValue(Model)" class="form-control" placeholder="Név" />
                                        <input name="@agentProp" value="@Model.GetType().GetProperty(agentProp).GetValue(Model)" class="form-control" placeholder="Hatóanyag" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Akció gombok -->
        <div class="mt-4 p-3 bg-light rounded-3 d-flex justify-content-end gap-2 border">
            <a asp-action="SlaughterSupportIndex" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i> Mégse
            </a>
            <button type="submit" class="btn btn-success px-5 shadow-sm">
                <i class="bi bi-check-lg me-1"></i> Beállítások mentése
            </button>
        </div>
    </form>
</div>

<style>
    /* Finomítás a kártyákhoz */
    .card { border-radius: 12px; overflow: hidden; }
    .card-header { border-bottom: 1px solid rgba(0,0,0,.05); }
    .input-group-text { color: #6c757d; }
    .form-control:focus { box-shadow: none; border-color: #198754; }
</style>