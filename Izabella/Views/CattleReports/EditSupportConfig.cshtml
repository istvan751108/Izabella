@model Izabella.Models.SupportFormConfig

<div class="container-fluid">
    <h4>2334-es nyomtatvány alapbeállításai</h4>
    <hr />
    <form asp-action="EditSupportConfig">
        <input type="hidden" asp-for="Id" />
        
        <div class="row">
            <div class="col-md-6">
                <h5>Engedélyes (Vágóhíd/Szervezet) adatai</h5>
                <div class="form-group mb-3">
                    <label>Engedélyes neve (3. mező)</label>
                    <input asp-for="LicenseeName" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label>Engedélyes Ügyfél-azonosítója</label>
                    <input asp-for="LicenseeClientId" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label>Aláírás helyszíne</label>
                    <input asp-for="FilingPlace" class="form-control" />
                </div>
            </div>
            
            <div class="col-md-6">
                <h5>Alapértelmezett Gyógyszerek (2. oldal)</h5>
                <div class="form-group mb-2">
                    <label>Gyógyszer 1 (Név / Hatóanyag)</label>
                    <div class="input-group">
                        <input asp-for="Medication1Name" class="form-control" placeholder="Név" />
                        <input asp-for="Medication1Agent" class="form-control" placeholder="Hatóanyag" />
                    </div>
                </div>
                <div class="form-group mb-2">
                    <label>Gyógyszer 2 (Név / Hatóanyag)</label>
                    <div class="input-group">
                        <input asp-for="Medication2Name" class="form-control" placeholder="Név" />
                        <input asp-for="Medication2Agent" class="form-control" placeholder="Hatóanyag" />
                    </div>
                </div>
                <div class="form-group mb-2">
                    <label>Gyógyszer 3 (Név / Hatóanyag)</label>
                    <div class="input-group">
                        <input asp-for="Medication3Name" class="form-control" placeholder="Név" />
                        <input asp-for="Medication3Agent" class="form-control" placeholder="Hatóanyag" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success">Mentés</button>
            <a asp-action="SlaughterSupportIndex" class="btn btn-secondary">Vissza</a>
        </div>
    </form>
</div>