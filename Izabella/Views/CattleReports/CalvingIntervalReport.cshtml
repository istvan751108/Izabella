@model Izabella.Models.ViewModels.CalvingIntervalReportViewModel

@{
    ViewData["Title"] = "Két ellés közötti idő (KEI) Riport";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calendar-range text-primary"></i> Két ellés közötti idő (KEI) alakulása</h2>
        <a asp-action="Index" asp-controller="CattleReports" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Vissza a riportokhoz
        </a>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body bg-light">
            <form method="get" asp-action="CalvingIntervalReport" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Év</label>
                    <select name="year" class="form-select">
                        @foreach (int y in ViewBag.Years)
                        {
                            <option value="@y" selected="@(y == Model.Year)">@y</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Hónap</label>
                    <select name="month" class="form-select">
                        @foreach (int m in ViewBag.Months)
                        {
                            <option value="@m" selected="@(m == Model.Month)">@m.ToString("D2").</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel-fill"></i> Szűrés
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary h-100 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h6 class="card-subtitle mb-2 text-muted uppercase fw-bold">Átlagos KEI ebben a hónapban</h6>
                    @if (Model.AverageIntervalDays > 0)
                    {
                        <h1 class="card-title text-primary display-4 fw-bold">@Model.AverageIntervalDays <span class="fs-4">nap</span></h1>
                        <p class="card-text text-muted">Célérték: 380 - 410 nap</p>
                    }
                    else
                    {
                        <h3 class="card-title text-warning my-3">Nincs adat</h3>
                        <p class="card-text text-muted">Ebben a hónapban nem volt többször ellett tehén.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success h-100 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h6 class="card-subtitle mb-2 text-muted uppercase fw-bold">Havi összes ellés</h6>
                    <h1 class="card-title text-success display-4 fw-bold">@Model.TotalCalvingsInMonth <span class="fs-4">db</span></h1>
                    <p class="card-text text-muted">Az állományban történt összes ellés száma.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info h-100 shadow-sm text-center">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h6 class="card-subtitle mb-2 text-muted uppercase fw-bold">Kiértékelt tehenek száma</h6>
                    <h1 class="card-title text-info display-4 fw-bold">@Model.MultiParousCalvingsCount <span class="fs-4">db</span></h1>
                    <p class="card-text text-muted">Azon tehenek, amelyeknek legalább a 2. ellésük volt.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="card-title mb-0"><i class="bi bi-list-columns"></i> Részletes ellési jegyzék (@(Model.Year). @(Model.Month). hó)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Ellés dátuma</th>
                            <th>Fülszám</th>
                            <th>ENAR szám</th>
                            <th class="text-center">Aktuális laktáció</th>
                            <th class="text-end pe-3">Két ellés közötti idő</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Details.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center p-4 text-muted">Nem történt ellés a kiválasztott időszakban.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Details.OrderBy(d => d.CalvingDate))
                            {
                                <tr>
                                    <td class="ps-3">@item.CalvingDate.ToString("yyyy.MM.dd.")</td>
                                    <td><strong class="text-dark">@item.EarTag</strong></td>
                                    <td>@item.EnarNumber</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@item.LactationNo. laktáció</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (item.IntervalDays > 0)
                                        {
                                            <span class="fw-bold @(item.IntervalDays > 420 ? "text-danger" : "text-success")">
                                                @item.IntervalDays nap
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted italic">Első ellés (Üsző)</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>