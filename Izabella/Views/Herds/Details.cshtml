@model Izabella.Models.Herd

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-info-circle text-info me-2"></i>Tenyészet részletei</h4>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Vissza a listához
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0">@Model.Name</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <label class="col-sm-4 text-muted fw-bold">Tenyészetkód:</label>
                        <div class="col-sm-8 text-primary fw-bold fs-5">@Model.HerdCode</div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-4 text-muted fw-bold">Tulajdonos cég:</label>
                        <div class="col-sm-8">@Model.Company?.Name</div>
                    </div>
                    <hr />
                    <div class="row mb-3">
                        <label class="col-sm-4 text-muted fw-bold">Alapértelmezett Prefix:</label>
                        <div class="col-sm-8"><code>@Model.DefaultPrefix</code></div>
                    </div>
                    <div class="row mb-0">
                        <label class="col-sm-4 text-muted fw-bold">ENAR Prefix:</label>
                        <div class="col-sm-8"><code>@Model.EnarPrefix</code></div>
                    </div>
                </div>
                <div class="card-footer bg-light text-end">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">Szerkesztés</a>
                </div>
            </div>
        </div>
    </div>
</div>