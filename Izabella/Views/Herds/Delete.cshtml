@model Izabella.Models.Herd

<div class="container-fluid px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white py-3 text-center">
                    <h5 class="card-title mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Tenyészet törlése</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="mb-1 text-muted small text-uppercase fw-bold">Törlendő objektum:</p>
                    <h3 class="text-dark">@Model.Name</h3>
                    <div class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 mt-2">
                        Tenyészetkód: @Model.HerdCode
                    </div>
                    
                    <p class="mt-4 text-secondary">
                        Figyelem: A tenyészet törlése befolyásolhatja a hozzárendelt állatokat!
                        Biztosan folytatja?
                    </p>

                    <form asp-action="Delete" class="mt-4 d-flex justify-content-center gap-2">
                        <input type="hidden" asp-for="Id" />
                        <a asp-action="Index" class="btn btn-secondary px-4">Mégse</a>
                        <button type="submit" class="btn btn-danger px-4">Törlés végrehajtása</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>