@model IEnumerable<Izabella.Models.DiscrepancyItem>

@{
    ViewData["Title"] = "Afimilk Összevetés Eredménye";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1 class="display-6 fw-bold text-dark"><i class="bi bi-arrow-left-right text-primary"></i> Adategyeztetés Eredménye</h1>
        <p class="text-muted">Az Izabella adatbázis és a legfrissebb Afimilk állapot összehasonlítása</p>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm bg-light text-center py-5">
            <div class="card-body">
                <i class="bi bi-shield-check text-success display-1 mb-3"></i>
                <h2 class="text-success fw-bold">Az adatok teljesen naprakészek!</h2>
                <p class="fs-5 text-muted mb-0">Nincs eltérés az Izabella és az Afimilk szárazonálló listája között. Minden szinkronban van.</p>
                <a asp-action="SeparationList" class="btn btn-outline-secondary mt-4">Vissza a munkalapokhoz</a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning d-flex align-items-center shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
            <div>
                <strong>Eltéréseket találtunk!</strong> Összesen @Model.Count() darab tehén állapota tér el a két rendszerben. Kérjük, egyeztesd az állatorvossal vagy pótold a telepi rögzítést.
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 fw-bold text-secondary">Eltérések részletes listája</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fülszám</th>
                                <th>Izabella státusz</th>
                                <th>Afimilk státusz</th>
                                <th>Probléma jellege</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.DiscrepancyType == "MissingFromAfi" ? "table-danger-light" : "table-warning-light")">
                                    <td class="fw-bold fs-5">@item.EarTag</td>
                                    <td>
                                        <span class="badge @(item.IzabellaStatus.Contains("Száraz") ? "bg-success" : "bg-primary")">
                                            @item.IzabellaStatus
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.AfimilkStatus.Contains("Száraz") ? "bg-success" : "bg-primary")">
                                            @item.AfimilkStatus
                                        </span>
                                    </td>
                                    <td class="text-dark">
                                        <i class="bi bi-info-circle-fill me-1 text-secondary"></i>
                                        @item.Message
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-4 text-end">
            <button onclick="window.print();" class="btn btn-outline-dark"><i class="bi bi-printer"></i> Lista nyomtatása az orvosnak</button>
            <a asp-action="SeparationList" class="btn btn-primary ms-2">Rendben</a>
        </div>
    }
</div>

<style>
    .table-danger-light {
        background-color: #fff5f5;
    }

    .table-warning-light {
        background-color: #fffdf0;
    }
</style>