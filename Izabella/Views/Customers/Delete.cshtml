@model Izabella.Models.Customer
@{
    ViewData["Title"] = "Törlés megerősítése";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow">
                <div class="card-body p-4 text-center">
                    <div class="display-4 text-danger mb-3"><i class="bi bi-exclamation-triangle"></i></div>
                    <h4 class="fw-bold">Vásárló törlése</h4>
                    <p class="text-muted">Biztosan törölni szeretné a következő partnert?</p>
                    
                    <div class="bg-light p-3 rounded mb-4">
                        <h5 class="mb-1 fw-bold">@Model.Name</h5>
                        <small>@Model.Address</small>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg">Igen, törlöm</button>
                            <a asp-action="Index" class="btn btn-link text-muted">Mégsem, vissza a listához</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>