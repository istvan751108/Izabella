@model IEnumerable<Izabella.Models.Customer>

@{
    ViewData["Title"] = "Vásárlók";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 text-primary fw-bold"><i class="bi bi-people-fill me-2"></i>Vásárlók / Partnerek</h4>
            <small class="text-muted">Nyilvántartott vevők és elérhetőségeik</small>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Új Vásárló felvitele
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Név / Cím</th>
                        <th>Adószám</th>
                        <th>Elérhetőség</th>
                        <th class="text-end pe-4">Műveletek</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.Name</div>
                                <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@item.Address</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fw-normal">@item.TaxNumber</span>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-telephone me-2 text-primary"></i>@item.Phone</div>
                                <div class="small"><i class="bi bi-envelope me-2 text-primary"></i>@item.Email</div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Szerkesztés">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Részletek">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Törlés">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>