@using Izabella.Models.ViewModels
@model IEnumerable<Izabella.Models.ViewModels.UserVm>

<div class="container-fluid px-4 py-3">
    <!-- Értesítések (széles elrendezésben) -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Hiba!</strong> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Fejléc szekció -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0"><i class="bi bi-people-fill text-secondary me-2"></i>Felhasználók kezelése</h4>
            <small class="text-muted">Rendszerhozzáférések és jogosultsági szintek adminisztrációja</small>
        </div>
        <button class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
            <i class="bi bi-person-plus-fill me-1"></i> Új felhasználó
        </button>
    </div>

    <!-- Felhasználói lista kártyában -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3">Email / Felhasználónév</th>
                            <th>Jogosultság</th>
                            <th class="text-end pe-4">Műveletek</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3 bg-light text-primary">
                                            @user.Email.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-bold">@user.Email</span>
                                        @if (user.Email == User.Identity.Name)
                                        {
                                            <span class="ms-2 badge rounded-pill bg-secondary small" style="font-size: 0.7rem;">Én</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(user.Role == "Admin" ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-info-subtle text-info border border-info-subtle") px-3">
                                        <i class="bi @(user.Role == "Admin" ? "bi-shield-lock" : "bi-person") me-1"></i> @user.Role
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    @if (user.Email != User.Identity.Name)
                                    {
                                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" 
                                              onsubmit="return confirm('Biztosan törölni akarja ezt a felhasználót? A művelet nem vonható vissza.');" style="display:inline;">
                                            <button type="submit" class="btn btn-outline-danger btn-sm shadow-sm">
                                                <i class="bi bi-trash me-1"></i> Törlés
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light disabled border" title="Saját magát nem törölheti">
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modernizált Modal az új felhasználóhoz -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="CreateUser" method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="createUserModalLabel"><i class="bi bi-person-plus me-2"></i>Új felhasználó felvétele</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">Email cím</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input name="Email" type="email" class="form-control shadow-sm" placeholder="pelda@izabelladb.hu" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">Jelszó</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input name="Password" type="password" class="form-control shadow-sm" required />
                        </div>
                        <div class="form-text mt-1 small">Minimum 6 karakter, kis- és nagybetű, szám.</div>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold small text-uppercase text-muted">Jogosultság</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-shield-check"></i></span>
                            <select name="Role" class="form-select shadow-sm">
                                <option value="User">Standard User (Megtekintés)</option>
                                <option value="Admin">System Admin (Teljes hozzáférés)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal">Mégse</button>
                    <button type="submit" class="btn btn-success px-4 shadow-sm">
                        <i class="bi bi-person-check me-1"></i> Felhasználó létrehozása
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Felhasználó ikon a név mellett */
    .avatar-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.9rem;
        border: 1px solid #dee2e6;
    }

    /* Modal finomítások */
    .modal-content { border-radius: 15px; overflow: hidden; }
    .form-control:focus, .form-select:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.1);
    }
    
    /* Egyedi badge stílusok a szerepkörökhöz */
    .bg-danger-subtle { background-color: #f8d7da !important; color: #842029 !important; }
    .bg-info-subtle { background-color: #cff4fc !important; color: #055160 !important; }
</style>