@using Izabella.Models.ViewModels
@model IEnumerable<Izabella.Models.ViewModels.SemenUsageReportViewModel>

@{
    ViewData["Title"] = "Felhasználási összesítő";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Év</label>
                    <input type="number" name="year" class="form-control" value="@ViewBag.SelectedYear" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Hónap</label>
                    <select name="month" class="form-select">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(i == ViewBag.SelectedMonth)">@i. Hónap</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Nap (opcionális)</label>
                    <input type="number" name="day" class="form-control" placeholder="Mindegy" value="@ViewBag.SelectedDay" min="1" max="31" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">SZŰRÉS</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white p-3">
            <h4 class="mb-0"><i class="bi bi-bar-chart"></i> Felhasználási Összesítő</h4>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-secondary text-uppercase">
                    <tr>
                        <th>Bika (KLSZ - Név)</th>
                        <th class="text-center">Termékenyítés (db)</th>
                        <th class="text-center">Rátermékenyítés (db)</th>
                        <th class="text-center text-danger">Selejt (db)*</th>
                        <th class="text-center fw-bold">Összes fogyás</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center p-5 text-muted">Nincs forgalom a megadott időszakban.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Klsz - @item.BullName</td>
                            <td class="text-center">@item.InseminationCount</td>
                            <td class="text-center">@item.ReInseminationCount</td>
                            <td class="text-center text-danger">@item.ScrapCount</td>
                            <td class="text-center fw-bold bg-light">@item.TotalUsage</td>
                        </tr>
                    }
                </tbody>
                @if (Model != null && Model.Any())
                {
                    <tfoot class="table-dark">
                        <tr>
                            <td>ÖSSZESEN:</td>
                            <td class="text-center">@Model.Sum(x => x.InseminationCount)</td>
                            <td class="text-center">@Model.Sum(x => x.ReInseminationCount)</td>
                            <td class="text-center">@Model.Sum(x => x.ScrapCount)</td>
                            <td class="text-center">@Model.Sum(x => x.TotalUsage)</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
        <div class="card-footer text-muted small">
            * Megjegyzés: A selejtezések adataihoz külön naplózás szükséges a QuickScrap funkcióban.
        </div>
    </div>
</div>