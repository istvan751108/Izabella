@model Izabella.Models.InseminationLog
@using Izabella.Models

<div class="container mt-4">
    <div class="card shadow-sm border-0 mb-4 bg-primary text-white">
        <div class="card-body p-4">
            <h2 class="mb-3"><i class="bi bi-search"></i> Állat Keresése</h2>
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-8 col-md-10">
                    <input type="text" name="searchEarTag" class="form-control form-control-lg"
                           placeholder="Írd be a tehén fülszámát..." value="@Model.CattleEarTag" autofocus />
                </div>
                <div class="col-4 col-md-2">
                    <button type="submit" class="btn btn-light btn-lg w-100 fw-bold">KERESÉS</button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.Cattle != null)
    {
        var c = (Cattle)ViewBag.Cattle;
        var last = (InseminationLog)ViewBag.LastInsem;

        // Színkódolás a státuszhoz
        string statusClass = c.PregnancyStatus switch
        {
            PregnancyStatus.Vemhes => "bg-success text-white",
            PregnancyStatus.NemVizsgált => "bg-info text-dark",
            PregnancyStatus.Visszaivarzott => "bg-warning text-dark",
            _ => "bg-secondary text-white"
        };

        <div class="card shadow border-0 overflow-hidden">
            <div class="card-header @statusClass d-flex justify-content-between align-items-center py-3">
                <h3 class="mb-0">@c.EarTag</h3>
                <span class="badge bg-white text-dark fs-5">@c.PregnancyStatus</span>
            </div>
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <div class="row">
                            <div class="col-6">
                                <label class="text-muted small uppercase fw-bold">Utolsó termékenyítés</label>
                                <p class="fs-5 fw-bold">@(last != null ? last.EventDate.ToShortDateString() : "Nincs adat")</p>
                            </div>
                            <div class="col-6">
                                <label class="text-muted small uppercase fw-bold">Alkalmazott bika</label>
                                <p class="fs-5 fw-bold">@(last != null ? $"{last.BullSemen.Klsz} - {last.BullSemen.BullName}" : "-")</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 text-md-end">
                        <a asp-action="Create" asp-controller="Insemination" asp-route-earTag="@c.EarTag"
                               class="btn btn-success btn-lg px-5 py-3 fw-bold shadow">
                            <i class="bi bi-needle"></i> TERMÉKENYÍTÉS RÖGZÍTÉSE
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>