@model Izabella.Models.MilkQualityLab
@{
    ViewData["Title"] = "Új Laborvizsgálat rögzítése";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="mb-0 fw-bold"><i class="bi bi-flask"></i> Tejvizsgálati Laboreredmények rögzítése</h4>
        </div>
        <div class="card-body p-4">
            <form asp-controller="MilkQualityLab" asp-action="Create" asp-route-returnMonth="@ViewBag.ReturnMonth" method="post">
                <input type="hidden" name="returnMonth" value="@ViewBag.ReturnMonth" />

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="RecordDate" class="form-label fw-bold">Mintavétel / Vizsgálat Napja</label>
                        <input asp-for="RecordDate" class="form-control form-control-lg" type="date" />
                        <span asp-validation-for="RecordDate" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="FatPercentage" class="form-label fw-bold">Zsír %</label>
                        <input asp-for="FatPercentage" class="form-control" type="number" step="0.01" placeholder="Pl: 3.85" />
                    </div>
                    <div class="col-6">
                        <label asp-for="ProteinPercentage" class="form-label fw-bold">Fehérje %</label>
                        <input asp-for="ProteinPercentage" class="form-control" type="number" step="0.01" placeholder="Pl: 3.25" />
                    </div>
                    <div class="col-6">
                        <label asp-for="SomaticCellCount" class="form-label fw-bold">Szomatikus Sejtszám (Mért/Átlag)</label>
                        <input asp-for="SomaticCellCount" class="form-control" type="text" placeholder="Pl: 240/180" />
                    </div>
                    <div class="col-6">
                        <label asp-for="BacteriaCount" class="form-label fw-bold">Csíraszám (Mért/Átlag)</label>
                        <input asp-for="BacteriaCount" class="form-control" type="text" placeholder="Pl: 15/20" />
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                    @if (!string.IsNullOrEmpty(ViewBag.ReturnMonth))
                    {
                        <a asp-controller="MilkReport" asp-action="MonthlyStatement" asp-route-monthFilter="@ViewBag.ReturnMonth" class="btn btn-outline-secondary">Vissza a kimutatáshoz</a>
                    }
                    else
                    {
                        <a asp-controller="MilkSale" asp-action="Index" class="btn btn-outline-secondary">Vissza a főoldalra</a>
                    }
                    <button type="submit" class="btn btn-warning px-4 fw-bold">Laboradatok Mentése</button>
                </div>
            </form>
        </div>
    </div>
</div>