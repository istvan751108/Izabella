@model Izabella.Models.ViewModels.DailyReportVm

<div class="container-fluid px-4 py-3">
    <!-- Felső vezérlőpult (Nyomtatásban rejtve) -->
    <div class="card shadow-sm border-0 mb-4 d-print-none">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <h4 class="mb-0 text-primary fw-bold">
                        <i class="bi bi-file-earmark-bar-graph me-2"></i>@Model.Year. @Model.Month. havi riport
                    </h4>
                </div>
                <div class="col-md-8 text-md-end">
                    <form method="get" class="d-inline-flex g-2">
                        <input type="number" name="year" value="@Model.Year" class="form-control form-control-sm me-1" style="width: 80px;" />
                        <input type="number" name="month" value="@Model.Month" min="1" max="12" class="form-control form-control-sm me-2" style="width: 60px;" />
                        <button type="submit" class="btn btn-primary btn-sm px-3 me-3">Betöltés</button>
                    </form>
                    <div class="btn-group shadow-sm">
                        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-printer me-1"></i> PDF Nyomtatás
                        </button>
                        <button id="exportExcel" class="btn btn-success btn-sm">
                            <i class="bi bi-file-earmark-excel me-1"></i> Excel Export
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gyors összesítők (Dashboard stílus) -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 border-start border-4 border-info shadow-sm h-100">
                <div class="card-body py-2">
                    <div class="small text-muted text-uppercase fw-bold">Havi Hígtrágya</div>
                    <div class="h4 mb-0 fw-bold">@Model.LiquidTotal <small class="text-muted">m³</small></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 border-start border-4 border-success shadow-sm h-100">
                <div class="card-body py-2">
                    <div class="small text-muted text-uppercase fw-bold">Havi Istállótrágya</div>
                    <div class="h4 mb-0 fw-bold">@(Model.SolidTotal / 1000) <small class="text-muted">t</small></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 border-start border-4 border-primary shadow-sm h-100">
                <div class="card-body py-2">
                    <div class="small text-muted text-uppercase fw-bold">Éves Híg (@Model.Year)</div>
                    <div class="h5 mb-0 fw-bold text-primary">@Model.YearlyLiquid m³</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 border-start border-4 border-warning shadow-sm h-100">
                <div class="card-body py-2">
                    <div class="small text-muted text-uppercase fw-bold">Éves Szilárd (@Model.Year)</div>
                    <div class="h5 mb-0 fw-bold text-warning">@(Model.YearlySolid / 1000) t</div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÍGTRÁGYA TÁBLÁZAT -->
    <div class="card shadow-sm border-0 mb-5 overflow-hidden">
        <div class="card-header bg-info text-white py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 small fw-bold text-uppercase italic"><i class="bi bi-droplet-fill me-2"></i>Hígtrágya Részletező</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 text-center border-bottom" id="liquidTable">
                <thead class="table-light text-secondary">
                    <tr class="small">
                        <th class="ps-3 text-start">Dátum</th>
                        <th>Összes (m³)</th>
                        <th>Tehén</th>
                        <th>6-9 hó</th>
                        <th>9-12 hó</th>
                        <th>12-vemhes</th>
                        <th>Vemhes</th>
                        <th>+ Bizonylat</th>
                        <th>- Bizonylat</th>
                        <th class="d-print-none pe-3">Művelet</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var l in Model.Liquids.OrderBy(x => x.Date))
                    {
                        <tr>
                            <td class="ps-3 text-start fw-bold">@l.Date.ToString("yyyy.MM.dd")</td>
                            <td class="table-info fw-bold">@l.TotalAmount</td>
                            <td>@l.Cow</td>
                            <td>@l.Young6_9</td>
                            <td>@l.Young9_12</td>
                            <td>@l.Young12Preg</td>
                            <td>@l.PregnantHeifer</td>
                            <td class="text-success fw-bold">@l.VoucherIn</td>
                            <td class="voucher-cell">
                                @foreach (var s in l.Splits)
                                {
                                    <div class="voucher-item text-danger border-danger-subtle">@s.VoucherNumber <small>(@s.Amount m³)</small></div>
                                }
                            </td>
                            <td class="d-print-none pe-3">
                                <div class="btn-group">
                                    <button class="btn btn-link btn-sm text-danger p-0 me-2" onclick="deleteItem(@l.Id, 'Liquid')" title="Törlés"><i class="bi bi-trash"></i></button>
                                    @if (!l.VoucherIn.StartsWith("STORNO"))
                                    {
                                        <button class="btn btn-link btn-sm text-warning p-0" onclick="stornoItem(@l.Id, 'Liquid')" title="Stornó"><i class="bi bi-arrow-counterclockwise"></i></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ISTÁLLÓTRÁGYA - SZÁLLÍTMÁNYOK -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-header bg-success text-white py-2">
            <h5 class="mb-0 small fw-bold text-uppercase"><i class="bi bi-truck me-2"></i>Istállótrágya Szállítmányok</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle mb-0 text-center" id="loadsTable">
                <thead class="table-light small">
                    <tr>
                        <th>Dátum</th>
                        <th>Rendszám</th>
                        <th>Célállomás</th>
                        <th>Bruttó</th>
                        <th>Tára</th>
                        <th class="table-success">Nettó (kg)</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var l in Model.Loads.OrderBy(x => x.Date))
                    {
                        <tr>
                            <td>@l.Date.ToString("yyyy.MM.dd")</td>
                            <td class="fw-bold">@l.LicensePlate</td>
                            <td>@l.Destination</td>
                            <td>@l.GrossWeight</td>
                            <td>@l.TareWeight</td>
                            <td class="fw-bold">@l.NetWeight</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- NAPI ÖSSZESÍTŐ (SZILÁRD) -->
    <div class="card shadow-sm border-0 mb-3 overflow-hidden">
        <div class="card-header bg-dark text-white py-2">
            <h5 class="mb-0 small fw-bold text-uppercase"><i class="bi bi-calculator me-2"></i>Szilárdtrágya Napi Összesítő</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0 text-center border-bottom" id="dailySolidTable">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-3 text-start">Dátum</th>
                        <th>Napi nettó (kg)</th>
                        <th>Tehén</th>
                        <th>Borjú (tej)</th>
                        <th>3-6 hó</th>
                        <th>6-9 hó</th>
                        <th>9-12 hó</th>
                        <th>Vemhes</th>
                        <th>+ Biz.</th>
                        <th>- Biz.</th>
                        <th class="d-print-none pe-3">Művelet</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var d in Model.Days.OrderBy(x => x.Date))
                    {
                        <tr>
                            <td class="ps-3 text-start fw-bold">@d.Date.ToString("yyyy.MM.dd")</td>
                            <td class="table-secondary fw-bold">@d.TotalNet</td>
                            <td>@d.Cow</td>
                            <td>@d.CalfMilk</td>
                            <td>@d.Calf3_6</td>
                            <td>@d.Young6_9</td>
                            <td>@d.Young9_12</td>
                            <td>@d.PregnantHeifer</td>
                            <td class="text-success fw-bold">@d.VoucherIn</td>
                            <td class="voucher-cell">
                                @if(!string.IsNullOrEmpty(d.VoucherOut)) {
                                    @foreach(var v in d.VoucherOut.Split(',', StringSplitOptions.RemoveEmptyEntries)) {
                                        <div class="voucher-item text-danger border-danger-subtle">@v.Trim()</div>
                                    }
                                }
                            </td>
                            <td class="d-print-none pe-3">
                                <div class="btn-group">
                                    <button class="btn btn-link btn-sm text-danger p-0 me-2" onclick="deleteItem(@d.Id, 'SolidDaily')"><i class="bi bi-trash"></i></button>
                                    @if (!string.IsNullOrEmpty(d.VoucherIn) && !d.VoucherIn.StartsWith("STORNO"))
                                    {
                                        <button class="btn btn-link btn-sm text-warning p-0" onclick="stornoItem(@d.Id, 'SolidDaily')"><i class="bi bi-arrow-counterclockwise"></i></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Általános UI finomítások */
    body { background-color: #f4f7f6; }
    .card { border-radius: 10px; }
    .table thead th { border-top: none; font-weight: 600; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.5px; }
    .voucher-item { font-size: 0.7rem; background: #fff; border-radius: 4px; margin: 2px 0; padding: 2px 4px; border: 1px solid #dee2e6; display: inline-block; }

    /* NYOMTATÁSI OPTIMALIZÁLÁS */
    @@media print {
        @@page { 
            size: landscape; 
            margin: 5mm !important; /* Minimális margó */
        }
        
        body { background-color: white !important; margin: 0 !important; padding: 0 !important; }
        .container-fluid { width: 100% !important; max-width: 100% !important; padding: 0 !important; margin: 0 !important; }

        /* Kényszerítjük, hogy a kártyák egymás mellett maradjanak (Flexbox fix) */
        .row { display: flex !important; flex-wrap: nowrap !important; margin: 0 -5px !important; }
        .col-md-3 { width: 25% !important; flex: 0 0 25% !important; max-width: 25% !important; padding: 0 5px !important; }
        
        /* Kártyák tömörítése nyomtatásban */
        .card { box-shadow: none !important; border: 1px solid #ddd !important; margin-bottom: 8px !important; }
        .card-body { padding: 8px !important; }
        .h4, .h5 { font-size: 1.1rem !important; }
        
        /* Táblázat széthúzása a teljes szélességre */
        table { width: 100% !important; table-layout: auto !important; border-collapse: collapse !important; }
        th, td { padding: 3px !important; font-size: 7.5pt !important; border: 1px solid #333 !important; }
        
        .d-print-none { display: none !important; }
        
        /* Színkódok megtartása nyomtatásban (ha a nyomtató engedi) */
        .table-info { background-color: #e3f2fd !important; -webkit-print-color-adjust: exact; }
        .table-success { background-color: #e8f5e9 !important; -webkit-print-color-adjust: exact; }
    }
</style>

@section Scripts {
    <script>
 $(function() {
    $("#exportExcel").click(function () {
    let year = "@Model.Year";
    let month = "@Model.Month";
    let fileName = "Tragya_Riport_" + year + "_" + month + ".xlsx";

    let masterTable = document.createElement("table");

    // Segédfüggvény: Excel-specifikus szélesség attribútumokkal
    const createCell = (row, text, width, isHeader = false) => {
        let cell = row.insertCell();
        cell.innerText = text;
        
        // Ez az attribútum a legfontosabb a tableToExcel könyvtárnak!
        if (width) {
            cell.setAttribute("data-t2e-width", width); 
        }

        // Stílusok az Excel számára
        cell.style.border = "thin solid #000000";
        cell.style.verticalAlign = "center";
        
        if (isHeader) {
            cell.style.fontWeight = "bold";
            cell.style.backgroundColor = "#D3D3D3";
            cell.style.textAlign = "center";
        } else {
            // Sortörés engedélyezése a cellán belül
            cell.style.whiteSpace = "normal"; 
        }
    };

    const addSectionTitle = (text, colSpan) => {
        let row = masterTable.insertRow();
        let cell = row.insertCell();
        cell.colSpan = colSpan;
        cell.innerText = text;
        cell.style.fontWeight = "bold";
        cell.style.backgroundColor = "#4F81BD";
        cell.style.color = "white";
        cell.style.textAlign = "center";
        cell.style.height = "30pt";
    };

    // --- 1. HÍGTRÁGYA SZEKCIÓ ---
    addSectionTitle("HÍGTRÁGYA RÉSZLETEZŐ", 9);
    let liquidRows = document.getElementById("liquidTable").rows;
    for (let i = 0; i < liquidRows.length; i++) {
        let newRow = masterTable.insertRow();
        let cells = liquidRows[i].cells;
        
        for (let j = 0; j < cells.length - 1; j++) {
            // Szélességek definiálása (karakteregységben vagy pixelben, könyvtártól függően)
            let width = 80; 
            if (j === 0) width = 100;  // Dátum
            if (j === 8) width = 450;  // Bizonylatok (Extra széles!)

            // Sortörések kezelése: a bizonylatokat új sorba tesszük az Excel cellán belül is
            let content = cells[j].innerText.trim();
            
            createCell(newRow, content, width, i === 0);
        }
    }

    masterTable.insertRow(); // Üres sor

    // --- 2. ISTÁLLÓTRÁGYA SZÁLLÍTMÁNYOK ---
    addSectionTitle("ISTÁLLÓTRÁGYA - SZÁLLÍTMÁNYOK", 6);
    let loadRows = document.getElementById("loadsTable").rows;
    for (let i = 0; i < loadRows.length; i++) {
        let newRow = masterTable.insertRow();
        let cells = loadRows[i].cells;
        for (let j = 0; j < cells.length; j++) {
            let width = 100;
            if (j === 2) width = 250; // Célállomás
            createCell(newRow, cells[j].innerText.trim(), width, i === 0);
        }
    }

    masterTable.insertRow();

    // --- 3. ISTÁLLÓTRÁGYA NAPI ÖSSZESÍTŐ ---
    addSectionTitle("ISTÁLLÓTRÁGYA - NAPI ÖSSZESÍTÉS", 10);
    let dailyRows = document.getElementById("dailySolidTable").rows;
    for (let i = 0; i < dailyRows.length; i++) {
        let newRow = masterTable.insertRow();
        let cells = dailyRows[i].cells;
        for (let j = 0; j < cells.length - 1; j++) {
            let width = 80;
            if (j === 0) width = 100;
            if (j >= 8) width = 300; // Bizonylat oszlopok
            createCell(newRow, cells[j].innerText.trim(), width, i === 0);
        }
    }

    // Exportálás indítása
    TableToExcel.convert(masterTable, {
        name: fileName,
        sheet: { name: "Havi Riport" }
    });
});
});
    function deleteItem(id, type) {
        if (!confirm("Biztosan törölni szeretnéd ezt a tételt?")) return;

        let url = type === 'Liquid' ? '/Manure/DeleteLiquid' : '/Manure/DeleteSolidDaily';

        $.ajax({
            url: url,
            type: 'POST',
            data: { id: id },
            success: function(res) {
    if (res.success) {
        showToast("Tétel törölve.");
        setTimeout(() => { location.reload(); }, 1500);
    } else {
        showToast("Hiba a törlés során!", true);
    }
}
        });
    }
    function stornoItem(id, type) {
    if (!confirm("Biztosan stornózni szeretnéd? Ez egy ellentétes előjelű tételt fog létrehozni.")) return;

    let url = type === 'Liquid' ? '/Manure/StornoLiquid' : '/Manure/StornoSolidDaily';

    $.ajax({
        url: url,
        type: 'POST',
        data: { id: id },
        success: function(res) {
            if (res.success) {
                showToast("Sikeres stornózás (negatív tétel létrehozva).");
                setTimeout(() => { location.reload(); }, 1500);
            } else {
                showToast("Hiba: " + res.message, true);
            }
        }
    });
}
    </script>
}