@model dynamic
@{
    ViewData["Title"] = "Trágyakezelési Statisztikák";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid px-4 py-3">
    <!-- Fejléc és Időszakválasztó -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h4 class="mb-0"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Trágyakezelési Statisztikák</h4>
                    <p class="text-muted small mb-0">Aktuális időszak: <strong>@ViewBag.Year. @ViewBag.Month. hónap</strong></p>
                </div>
                <div class="col-md-6">
                    <form method="get" class="row g-2 justify-content-md-end">
                        <div class="col-auto">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light">Év</span>
                                <input type="number" name="year" value="@ViewBag.Year" class="form-control" style="width: 80px;" />
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light">Hónap</span>
                                <input type="number" name="month" value="@ViewBag.Month" min="1" max="12" class="form-control" style="width: 70px;" />
                            </div>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary btn-sm px-3 shadow-sm">
                                <i class="bi bi-arrow-repeat me-1"></i> Frissítés
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Grafikon rács -->
    <div class="row g-4">
        <!-- Hígtrágya szekció -->
        <div class="col-12"><h5 class="text-secondary border-bottom pb-2"><i class="bi bi-droplet-fill text-info me-2"></i>Hígtrágya (m³)</h5></div>
        
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-info">
                <div class="card-body">
                    <h6 class="card-title text-muted fw-bold">Napi mennyiség</h6>
                    <canvas id="liquidDailyChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-muted fw-bold">Havi trendek (Éves)</h6>
                    <canvas id="liquidYearlyChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-muted fw-bold">Évek összehasonlítása</h6>
                    <canvas id="liquidCompChart" height="250"></canvas>
                </div>
            </div>
        </div>

        <!-- Istállótrágya szekció -->
        <div class="col-12 mt-5"><h5 class="text-secondary border-bottom pb-2"><i class="bi bi-truck text-success me-2"></i>Istállótrágya (t)</h5></div>

        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0 border-top border-4 border-success">
                <div class="card-body">
                    <h6 class="card-title text-muted fw-bold">Napi mennyiség</h6>
                    <canvas id="solidDailyChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-muted fw-bold">Havi trendek (Éves)</h6>
                    <canvas id="solidYearlyChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h6 class="card-title text-muted fw-bold">Évek összehasonlítása</h6>
                    <canvas id="solidCompChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Közös beállítások finomítása
        const commonOptions = { 
            responsive: true, 
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { 
                y: { beginAtZero: true, grid: { color: '#f0f0f0' } },
                x: { grid: { display: false } }
            }
        };
        
        const months = ['Jan', 'Feb', 'Már', 'Ápr', 'Máj', 'Jún', 'Júl', 'Aug', 'Szep', 'Okt', 'Nov', 'Dec'];

        // Adatok JSON-ből
        const data = {
            labels: @Html.Raw(Json.Serialize(ViewBag.DailyLabels)),
            liquid: @Html.Raw(Json.Serialize(ViewBag.LiquidDaily)),
            solid: @Html.Raw(Json.Serialize(ViewBag.SolidDaily)),
            yearlyL: @Html.Raw(Json.Serialize(ViewBag.YearlyLiquid)),
            yearlyS: @Html.Raw(Json.Serialize(ViewBag.YearlySolid)),
            compLabels: @Html.Raw(Json.Serialize(ViewBag.CompLabels)),
            compL: @Html.Raw(Json.Serialize(ViewBag.CompLiquid)),
            compS: @Html.Raw(Json.Serialize(ViewBag.CompSolid))
        };

        // 1. Napi híg (Line)
        new Chart(document.getElementById('liquidDailyChart'), {
            type: 'line', 
            data: { 
                labels: data.labels, 
                datasets: [{ label: 'm3', data: data.liquid, borderColor: '#0dcaf0', backgroundColor: 'rgba(13, 202, 240, 0.1)', fill: true, tension: 0.3 }] 
            }, options: commonOptions
        });

        // 2. Napi szilárd (Line)
        new Chart(document.getElementById('solidDailyChart'), {
            type: 'line', 
            data: { 
                labels: data.labels, 
                datasets: [{ label: 't', data: data.solid.map(v => v/1000), borderColor: '#198754', backgroundColor: 'rgba(25, 135, 84, 0.1)', fill: true, tension: 0.3 }] 
            }, options: commonOptions
        });

        // 3. Éves híg (Bar)
        new Chart(document.getElementById('liquidYearlyChart'), {
            type: 'bar', 
            data: { labels: months, datasets: [{ data: data.yearlyL, backgroundColor: '#0d6efd', borderRadius: 5 }] }, options: commonOptions
        });

        // 4. Éves szilárd (Bar)
        new Chart(document.getElementById('solidYearlyChart'), {
            type: 'bar', 
            data: { labels: months, datasets: [{ data: data.yearlyS.map(v => v/1000), backgroundColor: '#198754', borderRadius: 5 }] }, options: commonOptions
        });

        // 5. Összehasonlítás híg
        new Chart(document.getElementById('liquidCompChart'), {
            type: 'bar', 
            data: { labels: data.compLabels, datasets: [{ data: data.compL, backgroundColor: '#6610f2', borderRadius: 5 }] }, options: commonOptions
        });

        // 6. Összehasonlítás szilárd
        new Chart(document.getElementById('solidCompChart'), {
            type: 'bar', 
            data: { labels: data.compLabels, datasets: [{ data: data.compS.map(v => v/1000), backgroundColor: '#fd7e14', borderRadius: 5 }] }, options: commonOptions
        });
    </script>
}

<style>
    .card { transition: transform 0.2s; }
    .card:hover { transform: translateY(-3px); }
    canvas { max-height: 250px; }
    .border-info { border-color: #0dcaf0 !important; }
    .border-success { border-color: #198754 !important; }
</style>