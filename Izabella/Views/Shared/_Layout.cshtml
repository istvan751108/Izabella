<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Izabella</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <style>
        body { padding-top: 70px; background-color: #f4f7f6; }
        .navbar { background-color: #2c3e50 !important; }
        .nav-link { font-weight: 500; color: white !important; margin-right: 15px; }
        .nav-link:hover { color: #3498db !important; }
        .dropdown-menu { background-color: #2c3e50; border: 1px solid #34495e; }
        .dropdown-item { color: white; }
        .dropdown-item:hover { background-color: #3498db; color: white; }
        /* Tömörebb menü közepes és nagy felbontás között (992px - 1400px) */
        @@media (min-width: 992px) and (max-width: 1400px) {
            .nav-link {
                padding-left: 5px !important;
                padding-right: 5px !important;
                margin-right: 4px !important;
                font-size: 0.8rem; /* Kicsit kisebb betű, hogy beférjen */
            }
    
            .navbar-brand {
                margin-right: 2rem !important; /* Fix távolság a logó után */
                padding-left: 0;
            }

            /* Az ikonok melletti távolság csökkentése */
            .nav-link i {
                margin-right: 3px !important;
            }
        }
        /* Ha extra széles a képernyő, ne engedjük túl messzire szaladni a menüt, 
        de maradjon meg a balra zárt jelleg */
        @@media (min-width: 1600px) {
            .container-fluid {
                max-width: 95%; 
            }
        }
        /* Biztonsági tartalék: ha még így is szűkös lenne (pl. 13-as laptopon) */
        @@media (max-width: 1350px) {
            .nav-link {
                margin-right: 3px !important;
                font-size: 0.85rem !important;
            }
        }

        /* Fix: A dropdown-ok láthatóságának biztosítása */
        .navbar-collapse {
            overflow: visible !important; 
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-xl navbar-dark fixed-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            <i class="bi bi-database-fill-check me-2"></i>IZABELLA DB
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-2"></i>Főoldal</a>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="cattleDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-clipboard2-data"></i> Állomány kezelés
                    </a>
                    <ul class="dropdown-menu shadow dropdown-menu-dark" aria-labelledby="cattleDropdown">
                        <li><a class="dropdown-item" asp-controller="Cattle" asp-action="Calving"><i class="fa-solid fa-baby-carriage me-2 text-success"></i>Új ellés rögzítése</a></li>
                        <li><a class="dropdown-item" asp-controller="Cattle" asp-action="GenderChangeList"><i class="bi bi-gender-ambiguous me-2"></i>Borjú nemének megváltoztatása</a></li>
                        <li><a class="dropdown-item" asp-controller="Cattles" asp-action="Index"><i class="bi bi-list-ul me-2"></i>Aktív Állomány listája</a></li>
                        <li><a class="dropdown-item" asp-controller="Cattle" asp-action="PassportUpdate"><i class="bi bi-file-earmark-arrow-up me-2"></i>Marhalevél szám feltöltés</a></li>
                        <li><a class="dropdown-item" asp-controller="Sales" asp-action="Index"><i class="bi bi-journal-arrow-up me-2"></i>Kikerülési napló</a></li>
                        <li><a class="dropdown-item" asp-controller="Cattles" asp-action="LivestockUnitSummary"><i class="bi bi-calculator me-2"></i>Számos állat lekérdezés</a></li>
                        <li><a class="dropdown-item" asp-controller="Cattles" asp-action="Movement"><i class="bi bi-arrows-move me-2"></i>Állománymozgatás és Súlymérés</a></li>
                        <li><a class="dropdown-item" asp-controller="Sales" asp-action="MonthlyReport"><i class="bi bi-building-check me-2"></i>ENAR ügyintézés</a></li>
                        <li><a class="dropdown-item text-danger" asp-controller="Cattle" asp-action="DeathLogList"><i class="bi bi-exclamation-octagon me-2"></i>Elhullások naplója</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="ExitReport"><i class="fas fa-cow me-2"></i>Havi kikerülések</a></li>
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="ReclassificationReport"><i class="fas fa-repeat me-2"></i>Havi átminősítések</a></li>
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="MonthlyCowInventory"><i class="bi bi-123 me-2"></i>Tehén aktuális db-szám</a></li>
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="DailyFeedReport"><i class="fas fa-calculator me-2"></i>Napi létszám adatok</a></li>
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="MonthlyClosing"><i class="fas fa-lock me-2"></i>Havi Zárási adatok</a></li>
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="OffspringLog"><i class="fa-solid fa-baby me-2"></i>Szaporulati napló</a></li>
                    </ul>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="examDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-geo-alt"></i> Helyszíni műveletek
                    </a>
                    <ul class="dropdown-menu shadow dropdown-menu-dark">
                        <li><a class="dropdown-item" asp-controller="BloodTest" asp-action="BloodTestSelector"><i class="bi bi-droplet-fill me-2 text-danger"></i>Vérvizsgálat (Mintavétel)</a></li>
                        <li><a class="dropdown-item" asp-controller="Weight" asp-action="QuickWeightEntry"><i class="fa-solid fa-weight-hanging me-2"></i>Súlymérés</a></li>
                        <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Leltár</a></li>
                    </ul>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="insemDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-calendar-check"></i> Szaporodásbiológia
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark shadow">
                        <li><h6 class="dropdown-header text-info fw-bold">TERMÉKENYÍTÉS</h6></li>
                        <li><a class="dropdown-item" asp-controller="Insemination" asp-action="Index"><i class="bi bi-plus-circle me-2 text-success"></i>Új rögzítése</a></li>
                        <li><a class="dropdown-item" asp-controller="Insemination" asp-action="UsageSummary"><i class="bi bi-file-earmark-bar-graph me-2"></i>Felhasználási jelentés</a></li>
                        <li><a class="dropdown-item" asp-controller="SemenInventory" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Sperma készlet</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header text-danger fw-bold">VEMHESSÉGI VIZSGÁLAT</h6></li>
                        <li><a class="dropdown-item" asp-controller="Pregnancy" asp-action="Index"><i class="bi bi-search me-2 text-danger"></i>Várólista (VEX)</a></li>
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="ExpectedCalvings"><i class="fa-solid fa-venus-mars me-2"></i>Szaporodásbiológiai Riportok</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li> <a class="dropdown-item" asp-controller="Insemination" asp-action="Statistics"> <i class="bi bi-graph-up-arrow me-2 text-info"></i>Statisztika </a> </li>
                    </ul>
                </li>

                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="manureDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-moisture"></i> Trágyakezelés
                        </a>
                        <ul class="dropdown-menu shadow dropdown-menu-dark">
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" asp-controller="Manure" asp-action="Index"><i class="bi bi-plus-square me-2 text-success"></i>Trágya rögzítés</a></li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Report" asp-action="Index"><i class="bi bi-table me-2"></i>Havi riport (Táblázatok)</a></li>
                            <li><a class="dropdown-item" asp-controller="Report" asp-action="Charts"><i class="bi bi-graph-up me-2 text-info"></i>Grafikonok</a></li>
                        </ul>
                    </li>
                }

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="supportDropdown" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-file-earmark-pdf-fill"></i> Támogatások
                    </a>
                    <ul class="dropdown-menu shadow dropdown-menu-dark">
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="SlaughterSupportIndex"><i class="bi bi-truck me-2"></i>Vágóhídi (2334)</a></li>
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="PregnantSupportIndex"><i class="bi bi-gender-female me-2"></i>Vemhes üsző (2335)</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="CattleReports" asp-action="EditSupportConfig"><i class="bi bi-sliders me-2"></i>Beállítások</a></li>
                    </ul>
                </li>

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-gear-fill"></i> Admin
                        </a>
                        <ul class="dropdown-menu shadow dropdown-menu-dark">
                            <li><a class="dropdown-item" asp-controller="Companies" asp-action="Index"><i class="bi bi-building me-2"></i>Cégek</a></li>
                            <li><a class="dropdown-item" asp-controller="Customers" asp-action="Index"><i class="bi bi-people me-2"></i>Vásárlók</a></li>
                            <li><a class="dropdown-item" asp-controller="Herds" asp-action="Index"><i class="fa-solid fa-map-location-dot me-2"></i>Tenyészetek</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="DeathReasons" asp-action="Index"><i class="bi bi-question-circle me-2"></i>Elhullás okok</a></li>
                            <li><a class="dropdown-item" asp-controller="SemenInventory" asp-action="Index"><i class="bi bi-database-fill me-2"></i>Sperma készletkezelés</a></li>
                            <li><a class="dropdown-item" asp-controller="Mating" asp-action="Index"><i class="bi bi-heart-fill me-2 text-danger"></i>Bika párosítási javaslat</a></li>
                            <li><a class="dropdown-item" asp-controller="Staff" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Inszeminátorok</a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-person-lock me-2"></i>Felhasználók</a></li>
                        </ul>
                    </li>
                }
            </ul>
            <div class="navbar-nav">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </div>
</nav>

    <div class="container mt-4">
        @RenderBody()
        
        @* Toast értesítések *@
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body" id="toastMessage">Sikeres mentés!</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/tableToExcel.js"></script>

    <script>
        function showToast(message, isError = false) {
        const toastElement = document.getElementById('liveToast');
        const toastMessage = document.getElementById('toastMessage');
        if (!toastElement) return;

        // Szín beállítása
        toastElement.classList.remove('bg-success', 'bg-danger');
        toastElement.classList.add(isError ? 'bg-danger' : 'bg-success');

        toastMessage.innerText = message;

        // Autohide beállítása (5000ms = 5 másodperc)
        const toast = new bootstrap.Toast(toastElement, { delay: 5000, autohide: true });
        toast.show();
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>