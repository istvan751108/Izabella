@model Izabella.Models.Medication

@{
    ViewData["Title"] = "Gyógyszer szerkesztése";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="mb-4">
        <h1 class="display-5 fw-bold text-primary"><i class="bi bi-pencil-square"></i> Gyógyszer módosítása</h1>
        <p class="text-muted">Módosítsa a(z) <span class="fw-bold text-dark">@Model.Name</span> készítmény adatait.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Gyógyszer megnevezése</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Készlet mennyisége</label>
                        <input asp-for="Quantity" class="form-control" type="number" step="any" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Mértékegység</label>
                        <input asp-for="Unit" class="form-control" />
                        <span asp-validation-for="Unit" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Szokásos adagolás</label>
                        <input asp-for="DefaultDose" class="form-control" type="number" step="any" />
                        <span asp-validation-for="DefaultDose" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Kezelési kategória</label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Izabella.Models.TreatmentCategory>()"></select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12 my-3">
                        <div class="form-check form-switch card p-3 bg-light border-0">
                            <div class="d-flex align-items-center">
                                <input asp-for="IsAntibiotic" class="form-check-input me-3" type="checkbox" role="switch" id="antibioticSwitch" style="width: 2.5em; height: 1.25em;">
                                <label class="form-check-label fw-bold text-danger" for="antibioticSwitch">
                                    <i class="bi bi-exclamation-triangle-fill"></i> Ez a készítmény antibiotikumot tartalmaz
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light">
                            <label class="form-label fw-bold text-primary"><i class="bi bi-droplet-fill"></i> Tej várakozási idő (nap)</label>
                            <input asp-for="WithdrawalPeriodMilk" class="form-control" type="number" min="0" />
                            <span asp-validation-for="WithdrawalPeriodMilk" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded bg-light">
                            <label class="form-label fw-bold text-danger"><i class="bi bi-egg-fried"></i> Hús várakozási idő (nap)</label>
                            <input asp-for="WithdrawalPeriodMeat" class="form-control" type="number" min="0" />
                            <span asp-validation-for="WithdrawalPeriodMeat" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Mégse</a>
                    <button type="submit" class="btn btn-success btn-lg px-4 shadow-sm"><i class="bi bi-check-lg"></i> Módosítások mentése</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}