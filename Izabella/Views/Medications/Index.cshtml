@model IEnumerable<Izabella.Models.Medication>

@{
    ViewData["Title"] = "Gyógyszerkészlet";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-5 fw-bold text-primary"><i class="bi bi-capsule"></i> Gyógyszerraktár</h1>
            <p class="text-muted">Állatgyógyászati készítmények és apasztó tubusok kezelése</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-lg"></i> Új gyógyszer rögzítése
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Megnevezés / Típus</th>
                            <th>Kategória</th>
                            <th class="text-center">Készlet</th>
                            <th>Adagolás</th>
                            <th>Antibiotikum?</th>
                            <th>Várakozási idők (ÉVI)</th>
                            <th class="text-end pe-4">Műveletek</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            // Figyelmeztetés, ha kevés van (pl. 10 egység alatt)
                            var lowStockClass = item.Quantity < 10 ? "table-warning" : "";
                            var emptyStockClass = item.Quantity <= 0 ? "table-danger opacity-75" : "";

                            <tr class="@lowStockClass @emptyStockClass">
                                <td class="ps-4">
                                    <div class="fw-bold fs-5">@item.Name</div>
                                    <div class="small text-muted">Egység: @item.Unit</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-tag"></i> @item.Category
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="fs-4 fw-bold @(item.Quantity < 10 ? "text-danger" : "text-success")">
                                        @item.Quantity
                                    </span>
                                    <span class="small text-muted"> @item.Unit</span>
                                </td>
                                <td>
                                    <div class="small">Szokásos adag:</div>
                                    <span class="fw-bold">@item.DefaultDose</span> @item.Unit
                                </td>
                                <td>
                                    @if (item.IsAntibiotic)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-triangle"></i> IGEN
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Nem</span>
                                    }
                                </td>
                                <td>
                                    <div class="mb-1">
                                        <span class="badge @(item.WithdrawalPeriodMilk > 0 ? "bg-warning text-dark" : "bg-light text-dark border")" style="min-width: 115px; text-align: left;">
                                            <i class="bi bi-droplet-fill text-primary me-1"></i> @item.WithdrawalPeriodMilk nap (Tej)
                                        </span>
                                    </div>
                                    <div>
                                        <span class="badge @(item.WithdrawalPeriodMeat > 0 ? "bg-danger" : "bg-light text-dark border")" style="min-width: 115px; text-align: left;">
                                            <i class="bi bi-egg-fried me-1"></i> @item.WithdrawalPeriodMeat nap (Hús)
                                        </span>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm" title="Szerkeszt">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white" title="Adatlap">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Törlés">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                                    Nincs rögzített gyógyszer a készletben.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-warning {
        background-color: #fff9e6 !important;
    }

    .table-danger {
        background-color: #fceaea !important;
    }

    .badge {
        font-weight: 500;
    }
</style>