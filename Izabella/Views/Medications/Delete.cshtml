@model Izabella.Models.Medication

@{
    ViewData["Title"] = "Gyógyszer törlése";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white py-3 text-center">
            <h3 class="m-0 fw-bold"><i class="bi bi-exclamation-octagon-fill"></i> Biztosan törli ezt a tételt?</h3>
        </div>
        <div class="card-body text-center p-4">
            <p class="text-muted fs-5">A törlés után a készítmény és annak minden raktáradata véglegesen elvész.</p>

            <div class="bg-light rounded p-3 mb-4 border">
                <div class="text-uppercase small text-muted">Törlendő gyógyszer</div>
                <div class="display-6 fw-bold text-dark mt-1">@Model.Name</div>
                <span class="badge bg-secondary mt-2"><i class="bi bi-tag"></i> @Model.Category</span>
                <div class="mt-2 text-muted">Aktuális készlet: <strong>@Model.Quantity @Model.Unit</strong></div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Mégse (Vissza a listához)</a>
                    <button type="submit" class="btn btn-danger btn-lg px-4 shadow-sm"><i class="bi bi-trash"></i> Igen, végleges törlés</button>
                </div>
            </form>
        </div>
    </div>
</div>