@model IEnumerable<Izabella.Models.DeathReason>

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h4 class="mb-0">
                <i class="bi bi-clipboard2-x-fill text-secondary me-2"></i>Halálozási okok
            </h4>
            <small class="text-muted d-block mb-2">
                Kiesések és elhullások okainak rögzítése a statisztikákhoz
            </small>
            <span class="badge bg-secondary-subtle text-secondary border">
                Összesen: @Model.Count() rögzített kategória
            </span>
        </div>

        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Új Halálozási ok felvitele
        </a>
    </div>
    <div class="row">
        <div class="col-xl-8 col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-3">@Html.DisplayNameFor(model => model.Name)</th>
                                    <th class="text-end pe-4 py-3">Műveletek</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@Html.DisplayFor(modelItem => item.Name)</td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group btn-group-sm shadow-sm">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Szerkesztés">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Törlés">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="2" class="text-center py-5 text-muted italic">Nincs rögzített adat.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>