@model Izabella.Models.DeathReason

<div class="container-fluid px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info bg-opacity-10 py-3">
                    <h5 class="card-title mb-0 text-info-emphasis"><i class="bi bi-info-circle me-2"></i>Részletek</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="text-muted small fw-bold d-block mb-1 text-uppercase">Megnevezés</label>
                        <span class="h4">@Model.Name</span>
                    </div>
                    
                    <div class="border-top pt-3 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Vissza a listához</a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">Szerkesztés</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>